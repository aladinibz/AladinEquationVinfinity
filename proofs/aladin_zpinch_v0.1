# ─── ANIMATION – smooth fade ────────────────────────────────────────────────
fig, ax = plt.subplots(figsize=(8, 6))
im = ax.imshow(density_history[0], extent=[0, z_max*100, r_max*100, 0],
               cmap='inferno', aspect='auto', origin='lower', vmin=rho0*0.5, vmax=rho0*3)
ax.set_title("Density r-z Slice Evolution (mid-θ)")
ax.set_xlabel("z [cm]")
ax.set_ylabel("r [cm]")
cbar = fig.colorbar(im, ax=ax, label='Density [kg/m³]')

def update(frame):
    alpha = frame % 1.0
    idx = int(frame)
    if idx + 1 < len(density_history):
        blended = (1 - alpha) * density_history[idx] + alpha * density_history[idx + 1]
    else:
        blended = density_history[idx]
    im.set_array(blended)
    ax.set_title(f"Density r-z Slice Evolution (mid-θ) – step {idx*10}")
    return [im]

total_frames = (len(density_history) - 1) * 10
ani = FuncAnimation(fig, update, frames=np.linspace(0, len(density_history)-1, total_frames),
                    interval=80, blit=True)

ani.save("plots/v0.1_density_animation_fade.gif",
         writer='pillow',
         fps=15,
         dpi=100,
         loop=0)
plt.close(fig)

