plt.figure(figsize=(8, 6))
plt.imshow(rho[Ntheta//2, :, :].T, extent=[0, z_max*100, r_max*100, 0],
           cmap='inferno', aspect='auto', origin='lower')
plt.colorbar(label='Density [kg/m³]')
plt.title("v0.1 – Final Density r-z Slice (mid-θ)")
