GRID_SIZE = 128
DT = 1e-9
STEPS = 150
EPSILON = 0.18
K_PERT = 24.0
MODE = 3                 # 0=sausage, 1=m=1, 2=m=2, 3=m=3 kink

MU0 = 4 * np.pi * 1e-7
ETA = 1e-5
RAD_COEFF = 1e-30
V_MAX = 1.5e5
BETA_SHEAR = 2.0
J_Z_INIT = 1e6
GAMMA_EOS = 5.0 / 3.0

# Domain
L_r = 0.02
dx = L_r / GRID_SIZE
x = jnp.linspace(0, L_r, GRID_SIZE, dtype=jnp.float32)
y = jnp.linspace(0, L_r, GRID_SIZE, dtype=jnp.float32)
z = jnp.linspace(0, 0.1, GRID_SIZE, dtype=jnp.float32)

X, Y, Z = jnp.meshgrid(x, y, z, indexing='ij')
R = jnp.sqrt(X**2 + Y**2 + 1e-10)
THETA = jnp.arctan2(Y, X)

# ────────────────────────────────────────────────
# Initial conditions
# ────────────────────────────────────────────────
def init_state():
    rho = 1e-6 * jnp.exp(-(R / 0.01)**2).astype(jnp.float32)
    
    v_z = V_MAX * (1 - (R / 0.01)**BETA_SHEAR).astype(jnp.float32)
    v_x = jnp.zeros_like(rho)
    v_y = jnp.zeros_like(rho)
    
    J_z = J_Z_INIT * jnp.exp(-(R / 0.01)**2).astype(jnp.float32)
    B_theta = MU0 * J_z * jnp.minimum(R, 0.01) / 2
    B_x = -B_theta * Y / R
    B_y = B_theta * X / R
    B_z = jnp.zeros_like(rho)
    B = jnp.stack([B_x, B_y, B_z], axis=0).astype(jnp.float32)
    
    p = 1e5 * jnp.ones_like(rho)
    
    S = rho * jnp.stack([v_x, v_y, v_z], axis=0)
    
    v2 = v_x**2 + v_y**2 + v_z**2
    B2 = B_x**2 + B_y**2 + B_z**2
    tau = p / (GAMMA_EOS - 1) + 0.5 * rho * v2 + B2 / (2 * MU0)
    
    return {'rho': rho, 'S': S, 'tau': tau, 'B': B, 'p': p}

state = init_state()

# Mode-specific perturbation
if MODE == 0:
    delta = EPSILON * jnp.cos(K_PERT * Z)
elif MODE == 1:
    delta = EPSILON * jnp.cos(K_PERT * Z + THETA)
elif MODE == 2:
    delta = EPSILON * jnp.cos(2 * THETA + K_PERT * Z)
elif MODE == 3:
    delta = EPSILON * jnp.cos(3 * THETA + K_PERT * Z)
state['rho'] += state['rho'] * delta

# ────────────────────────────────────────────────
# Time step with full MHD advection + Lorentz + resistivity + radiation
# ────────────────────────────────────────────────
@jit
def step(state, dt, dx):
    rho = state['rho']
    S = state['S']
    tau = state['tau']
    B = state['B']
    p = state['p']

    v = S / rho

    # J = ∇ × B / MU0
    J_x = (jnp.gradient(B[2], axis=1) - jnp.gradient(B[1], axis=2)) / MU0
    J_y = (jnp.gradient(B[0], axis=2) - jnp.gradient(B[2], axis=0)) / MU0
    J_z = (jnp.gradient(B[1], axis=0) - jnp.gradient(B[0], axis=1)) / MU0
    J = jnp.stack([J_x, J_y, J_z], axis=0)

    # Lorentz J × B
    J_cross_B = jnp.cross(J, B, axis=0)
    dS_dt = J_cross_B

    # Conservative advection fluxes (HLL-like)
    f_rho = rho * v
    p_mag = jnp.sum(B**2, axis=0) / (2 * MU0)
    p_tot = p + p_mag
    vv = v[..., jnp.newaxis] * v
    BB = B[..., jnp.newaxis] * B
    eye3 = jnp.eye(3)[..., jnp.newaxis, jnp.newaxis, jnp.newaxis]
    f_S = rho * vv + p_tot * eye3 - BB / MU0
    f_tau = (tau + p + p_mag) * v
    f_B = v[..., jnp.newaxis] * B - B[..., jnp.newaxis] * v

    # Divergence
    drho_dt = - (jnp.gradient(f_rho[0], axis=0) + jnp.gradient(f_rho[1], axis=1) + jnp.gradient(f_rho[2], axis=2)) / dx
    dS_dt += - (jnp.gradient(f_S[0], axis=0) + jnp.gradient(f_S[1], axis=1) + jnp.gradient(f_S[2], axis=2)) / dx
    dtau_dt = - (jnp.gradient(f_tau[0], axis=0) + jnp.gradient(f_tau[1], axis=1) + jnp.gradient(f_tau[2], axis=2)) / dx
    dB_dt = - (jnp.gradient(f_B[0], axis=0) + jnp.gradient(f_B[1], axis=1) + jnp.gradient(f_B[2], axis=2)) / dx

    # Resistivity
    lap_B = (jnp.gradient(jnp.gradient(B, axis=1), axis=1) + 
             jnp.gradient(jnp.gradient(B, axis=2), axis=2) + 
             jnp.gradient(jnp.gradient(B, axis=3], axis=3)) / dx**2
    dB_dt += ETA * lap_B

    # Radiation cooling
    T = p / rho
    dp_dt = - RAD_COEFF * rho**2 * jnp.sqrt(T + 1e-10)

    # Updates
    rho += dt * drho_dt
    S += dt * dS_dt
    tau += dt * dtau_dt
    B += dt * dB_dt
    p += dt * dp_dt

    return {'rho': rho, 'S': S, 'tau': tau, 'B': B, 'p': p}

# Run simulation + collect center pressure
